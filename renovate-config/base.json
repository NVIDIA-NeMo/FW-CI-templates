{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared policy: grouped non-major updates after seven days; majors require dashboard approval.",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardApproval": false,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "automerge": false,
  "prCreation": "immediate",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "addLabels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": false
  },
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Queue each major upgrade for approval without grouping it with other packages.",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "groupName": null
    },
    {
      "description": "Open minor and patch update PRs automatically after the shared release-age check.",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "dependencyDashboardApproval": false
    }
  ]
}
